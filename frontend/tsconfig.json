{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["esnext", "dom", "DOM.Iterable"],
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "exclude": [
    "./dist",
