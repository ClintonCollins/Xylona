{
  "name": "xylona",
  "version": "0.0.1",
  "description": "A game server control panel.",
  "productName": "Xylona",
  "author": "Clinton Collins",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "bun eslint .",
    "lint:fix": "bun eslint --fix .",
    "format": "bun prettier --write \"src/**/*.{ts,vue,scss,html,json}\" \"e2e/**/*.ts\"",
    "format:check": "bun prettier --check \"src/**/*.{ts,vue,scss,html,json}\" \"e2e/**/*.ts\"",
    "test": "bunx vitest run --configLoader native",
    "test:watch": "bunx vitest --configLoader native",
    "test:ui": "bunx vitest --configLoader native --ui",
    "test:coverage": "bunx vitest run --configLoader native --coverage",
    "e2e:smoke": "bunx playwright test login.spec.ts smoke.spec.ts",
    "e2e": "bunx playwright test",
    "e2e:remote-node": "E2E_MODE=remote-node bunx playwright test --config playwright.config.ts remote-node.spec.ts",
    "e2e:ui": "bunx playwright test --ui",
    "e2e:headed": "bunx playwright test --headed",
    "e2e:debug": "bunx playwright test --debug",
    "e2e:report": "bunx playwright show-report e2e/playwright-report"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/goldman": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/zen-dots": "^5.3.0",
    "@quasar/extras": "^2.0.4",
    "chart.js": "^4.5.1",
    "cronstrue": "^3.24.0",
    "dompurify": "^3.4.14",
    "ini": "^7.0.0",
    "leaflet": "1.9.4",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "quasar": "^2.28.0",
    "quasar-extras-svg-icons": "^2.2.0",
    "smol-toml": "^1.8.0",
    "vue": "^3.5.42",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@quasar/app-vite": "2.6.2",
    "@quasar/vite-plugin": "1.12.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.14",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "8.0.16",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "dompurify": "^3.4.14",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "form-data": "4.0.6",
    "immutable": "5.1.8",
    "js-cookie": "3.0.8",
    "log-symbols": "^5",
    "ora": "^6",
    "postcss": "8.5.19",
    "vite": "8.0.16",
    "ws": "8.21.0"
  },
  "trustedDependencies": [
    "@bufbuild/buf",
    "@parcel/watcher",
    "esbuild"
  ],
  "packageManager": "bun@1.3.12"
}
