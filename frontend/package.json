{
  "name": "xylona",
  "version": "0.0.1",
  "description": "A game server control panel.",
  "productName": "Xylona",
  "author": "Clinton Collins",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,scss,html,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "e2e:federation": "playwright test --config playwright-federation.config.ts",
    "e2e:federation:headed": "playwright test --config playwright-federation.config.ts --headed",
    "e2e:federation:report": "playwright show-report e2e/playwright-report-federation"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@quasar/extras": "^1.17.0",
    "@types/highlightjs": "^9.12.6",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.6",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.20",
    "highlight.js": "^11.11.1",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "prismjs": "^1.30.0",
    "quasar": "^2.18.6",
    "quasar-extras-svg-icons": "^2.2.0",
    "stores": "^1.0.0",
    "vue": "^3.5.30",
    "vue-chartjs": "^5.3.3",
    "vue-prism-editor": "2.0.0-alpha.2",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.66.1",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.1",
    "@quasar/app-vite": "2.4.1",
    "@types/node": "^25.5.0",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "4.1.0",
    "@vitest/ui": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^20.8.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "vue-eslint-parser": "^10.4.0"
  },
  "pnpm": {
    "overrides": {
      "log-symbols": "^5",
      "ora": "^6"
    },
    "onlyBuiltDependencies": [
      "@bufbuild/buf",
      "@playwright/test",
      "@parcel/watcher",
      "esbuild",
      "quasar-extras-svg-icons"
    ]
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
