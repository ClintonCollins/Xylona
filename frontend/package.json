{
  "name": "xylona",
  "version": "0.0.1",
  "description": "A game server control panel.",
  "productName": "Xylona",
  "author": "Clinton Collins",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "bun eslint .",
    "lint:fix": "bun eslint --fix .",
    "format": "bun prettier --write \"src/**/*.{ts,vue,scss,html,json}\" \"e2e/**/*.ts\"",
    "format:check": "bun prettier --check \"src/**/*.{ts,vue,scss,html,json}\" \"e2e/**/*.ts\"",
    "test": "bunx vitest run --configLoader native",
    "test:watch": "bunx vitest --configLoader native",
    "test:ui": "bunx vitest --configLoader native --ui",
    "test:coverage": "bunx vitest run --configLoader native --coverage",
    "e2e:smoke": "bunx playwright test login.spec.ts smoke.spec.ts",
    "e2e": "bunx playwright test",
    "e2e:remote-node": "bunx playwright test --config playwright.remote.config.ts remote-node.spec.ts",
    "e2e:ui": "bunx playwright test --ui",
    "e2e:headed": "bunx playwright test --headed",
    "e2e:debug": "bunx playwright test --debug",
    "e2e:report": "bunx playwright show-report e2e/playwright-report"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@fontsource/exo-2": "^5.2.8",
    "@fontsource/goldman": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/zen-dots": "^5.2.8",
    "@quasar/extras": "^1.18.0",
    "@typescript/native-preview": "7.0.0-dev.20260323.1",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "cronstrue": "^3.14.0",
    "dayjs": "^1.11.20",
    "dompurify": "^3.3.2",
    "ini": "^6.0.0",
    "leaflet": "1.9.4",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "quasar": "^2.19.3",
    "quasar-extras-svg-icons": "^2.2.0",
    "smol-toml": "^1.6.1",
    "vue": "^3.5.30",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.0.4",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.66.1",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@quasar/app-vite": "2.6.0",
    "@quasar/vite-plugin": "1.11.0",
    "@types/leaflet": "1.9.20",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "6.0.5",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "8.0.16",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "dompurify": "^3.3.2",
    "brace-expansion": "5.0.5",
    "form-data": "4.0.6",
    "js-cookie": "3.0.8",
    "log-symbols": "^5",
    "ora": "^6",
    "vite": "8.0.16",
    "ws": "8.21.0"
  },
  "trustedDependencies": [
    "@bufbuild/buf",
    "@parcel/watcher",
    "esbuild"
  ],
  "packageManager": "bun@1.3.12"
}
