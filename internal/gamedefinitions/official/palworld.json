      {"command":"/Info","syntax":"/Info","summary":"Shows server information.","category":"Server","keywords":["information","status"],"documentationUrl":"https://docs.palworldgame.com/settings-and-operation/commands/","availability":"Mapped to the Palworld REST admin API; retain the slash.","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
