  "config_schemas": [
    {
      "path": "server.properties",
      "format": "properties",
      "category": "Server",
      "generate_before_start": true,
      "managed_fields": {
        "max-players": "game_server.max_players",
        "server-ip": "game_server.ip",
        "server-port": "game_server.port",
        "query.port": "game_server.query_port",
        "enable-rcon": "xylona.local_console_enabled",
        "rcon.port": "xylona.local_console_port",
        "rcon.password": "xylona.local_console_password"
      },
      "schema": {
        "type": "object",
        "x-groups": [
          "Identity",
          "Access",
          "Networking",
          "World"
        ],
        "properties": {
          "motd": {
            "type": "string",
            "title": "MOTD",
            "default": "A Minecraft Server",
            "x-group": "Identity",
            "x-order": 0
          },
          "max-players": {
            "type": "integer",
            "title": "Max players",
            "default": 32,
            "minimum": 1,
            "maximum": 500,
            "x-group": "Access",
            "x-order": 0,
            "x-managed": {
              "source": "game_server.max_players"
            }
          },
          "online-mode": {
            "type": "boolean",
            "title": "Online mode",
            "default": true,
            "x-group": "Access",
            "x-order": 1
          },
          "white-list": {
            "type": "boolean",
            "title": "Whitelist",
            "default": false,
            "x-group": "Access",
            "x-order": 2
          },
          "server-ip": {
            "type": "string",
            "title": "Bind IP",
            "default": "0.0.0.0",
            "x-group": "Networking",
            "x-order": 0,
            "x-managed": {
              "source": "game_server.ip"
            }
          },
          "server-port": {
            "type": "integer",
            "title": "Server port",
            "default": 25565,
            "minimum": 1,
            "maximum": 65535,
            "x-group": "Networking",
            "x-order": 1,
            "x-managed": {
              "source": "game_server.port"
            }
          },
          "enable-query": {
            "type": "boolean",
            "title": "Enable query",
            "default": true,
            "x-group": "Networking",
            "x-order": 2
          },
          "query.port": {
            "type": "integer",
            "title": "Query port",
            "default": 25565,
            "minimum": 1,
            "maximum": 65535,
            "x-group": "Networking",
            "x-order": 3,
            "x-managed": {
              "source": "game_server.query_port"
            }
          },
          "enable-rcon": {
            "type": "boolean",
            "title": "Enable RCON",
            "default": true,
            "x-group": "Networking",
            "x-order": 4,
            "x-managed": {
              "source": "xylona.local_console_enabled"
            }
          },
          "rcon.port": {
            "type": "integer",
            "title": "RCON port",
            "default": 25566,
            "minimum": 1,
            "maximum": 65535,
            "x-group": "Networking",
            "x-order": 5,
            "x-managed": {
              "source": "xylona.local_console_port"
            }
          },
          "rcon.password": {
            "type": "string",
            "title": "RCON password",
            "default": "",
            "x-secret": true,
            "x-group": "Networking",
            "x-order": 6,
            "x-managed": {
              "source": "xylona.local_console_password"
            }
          },
          "level-name": {
            "type": "string",
            "title": "World name",
            "default": "world",
            "x-group": "World",
            "x-order": 0
          },
          "level-seed": {
            "type": "string",
            "title": "World seed",
            "default": "",
            "x-group": "World",
            "x-order": 1
          },
          "gamemode": {
            "type": "string",
            "title": "Game mode",
            "default": "survival",
            "enum": [
              "survival",
              "creative",
              "adventure",
              "spectator"
            ],
            "x-group": "World",
            "x-order": 2
          }
        }
      }
    }
  ],
  "linux_start_args_template": [
    {
      "id": "01JQSA00000000000000000001",
      "order": 1,
      "ownership": "locked",
      "tokens": [
        "-Dlog4j2.formatMsgNoLookups=true"
      ],
      "label": "Log4j security fix"
    },
    {
      "id": "01JQSA00000000000000000002",
      "order": 2,
      "ownership": "system",
      "tokens": [
        "-Xms{{MAX_MEMORY_MB}}M"
      ],
      "label": "Min heap size",
      "managed_source": "game_server.max_memory_mb"
    },
    {
      "id": "01JQSA00000000000000000003",
      "order": 3,
      "ownership": "system",
      "tokens": [
        "-Xmx{{MAX_MEMORY_MB}}M"
      ],
      "label": "Max heap size",
      "managed_source": "game_server.max_memory_mb"
    },
    {
      "id": "01JQSA00000000000000000004",
      "order": 4,
      "ownership": "editable",
      "tokens": [
        "-XX:+UnlockExperimentalVMOptions"
      ],
      "label": "Unlock experimental VM options"
    },
    {
      "id": "01JQSA00000000000000000005",
      "order": 5,
      "ownership": "editable",
      "tokens": [
        "-XX:+UseZGC"
      ],
      "label": "Use ZGC"
    },
    {
      "id": "01JQSA00000000000000000006",
      "order": 6,
      "ownership": "editable",
      "tokens": [
        "-XX:+ZProactive"
      ],
      "label": "Enable proactive ZGC"
    },
    {
      "id": "01JQSA00000000000000000007",
      "order": 7,
      "ownership": "editable",
      "tokens": [
        "-XX:ZCollectionInterval=600"
      ],
      "label": "ZGC collection interval"
    },
    {
      "id": "01JQSA00000000000000000008",
      "order": 8,
      "ownership": "editable",
      "tokens": [
        "-XX:+DisableExplicitGC"
      ],
      "label": "Disable explicit GC"
    },
    {
      "id": "01JQSA00000000000000000009",
      "order": 9,
      "ownership": "editable",
      "tokens": [
        "-XX:+AlwaysPreTouch"
      ],
      "label": "Always pre-touch memory"
    },
    {
      "id": "01JQSA0000000000000000000A",
      "order": 10,
      "ownership": "editable",
      "tokens": [
        "-XX:+ParallelRefProcEnabled"
      ],
      "label": "Parallel reference processing"
    },
    {
      "id": "01JQSA0000000000000000000B",
      "order": 11,
      "ownership": "editable",
      "tokens": [
        "-XX:+PerfDisableSharedMem"
      ],
      "label": "Disable perf shared memory"
    },
    {
      "id": "01JQSA0000000000000000000C",
      "order": 12,
      "ownership": "system",
      "tokens": [
        "-jar",
        "{{SERVER_EXECUTABLE}}"
      ],
      "label": "Server executable",
      "managed_source": "server_executable"
    },
    {
      "id": "01JQSA0000000000000000000D",
      "order": 13,
      "ownership": "locked",
      "tokens": [
        "nogui"
      ],
      "label": "No graphical UI"
    }
  ],
