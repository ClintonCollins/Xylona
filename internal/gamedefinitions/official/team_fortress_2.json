    "consoleCommands": [
      {"command":"status","syntax":"status","summary":"Show server and player status.","description":"Prints server status and connected-player information.","category":"Information","aliases":[],"keywords":["players","connections","server"],"arguments":[],"examples":[{"command":"status","description":"Inspect current server and player status."}],"notes":[],"documentationUrl":"https://developer.valvesoftware.com/wiki/Console_Command_List/S","availability":"Source dedicated-server console","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"users","syntax":"users","summary":"List connected users.","description":"Prints users connected to the server.","category":"Players","aliases":[],"keywords":["players","list","userid"],"arguments":[],"examples":[{"command":"users","description":"List connected users."}],"notes":[],"documentationUrl":"https://developer.valvesoftware.com/wiki/Console_Command_List/U","availability":"Source dedicated-server console","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"say","syntax":"say <message>","summary":"Broadcast a server chat message.","description":"Sends a message from the server to connected players.","category":"Messaging","aliases":[],"keywords":["chat","broadcast","announce"],"arguments":[{"name":"message","description":"Message to send.","required":true,"repeatable":true,"valueType":"text","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"say Server restart in 5 minutes.","description":"Announce planned maintenance."}],"notes":[],"documentationUrl":"https://developer.valvesoftware.com/wiki/Console_Command_List/S","availability":"Source dedicated-server console","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"kick","syntax":"kick <name|userid>","summary":"Kick a player.","description":"Kicks a player identified by name, slot, or userid.","category":"Moderation","aliases":[],"keywords":["player","disconnect","userid"],"arguments":[{"name":"name|userid","description":"Player name, slot, or userid.","required":true,"repeatable":false,"valueType":"player-identifier","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"kick ExamplePlayer","description":"Disconnect a player by name."}],"notes":[],"documentationUrl":"https://developer.valvesoftware.com/wiki/Console_Command_List/K","availability":"Source dedicated-server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
      {"command":"changelevel","syntax":"changelevel <map>","summary":"Change the active map.","description":"Changes the running server to the specified map.","category":"World","aliases":[],"keywords":["map","level","change"],"arguments":[{"name":"map","description":"Map name to load.","required":true,"repeatable":false,"valueType":"map-name","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"changelevel cp_badlands","description":"Load cp_badlands."}],"notes":["Changing a level disrupts the active match."],"documentationUrl":"https://developer.valvesoftware.com/wiki/DevMsg","availability":"Source dedicated-server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
      {"command":"map","syntax":"map <map>","summary":"Load a map.","description":"Loads the specified map on the server.","category":"World","aliases":[],"keywords":["map","level","load"],"arguments":[{"name":"map","description":"Map name to load.","required":true,"repeatable":false,"valueType":"map-name","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"map cp_badlands","description":"Load cp_badlands."}],"notes":["Loading a map disrupts the active match."],"documentationUrl":"https://developer.valvesoftware.com/wiki/Console_Command_List/M","availability":"Source dedicated-server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
      {"command":"banid","syntax":"banid <minutes> <userid|steamid> [kick]","summary":"Ban a player by identifier.","description":"Adds a player identifier to the server ban list.","category":"Moderation","aliases":[],"keywords":["ban","player","steamid","userid"],"arguments":[{"name":"minutes","description":"Ban duration in minutes; 0 is permanent.","required":true,"repeatable":false,"valueType":"integer","suggestedValues":["0"],"defaultValue":""},{"name":"userid|steamid","description":"Player userid or Steam ID.","required":true,"repeatable":false,"valueType":"player-identifier","suggestedValues":[],"defaultValue":""},{"name":"kick","description":"Optional literal that immediately kicks the player.","required":false,"repeatable":false,"valueType":"literal","suggestedValues":["kick"],"defaultValue":""}],"examples":[{"command":"banid 0 76561198123456789 kick","description":"Permanently ban and kick a Steam ID."}],"notes":["Persist bans with writeid when appropriate."],"documentationUrl":"https://developer.valvesoftware.com/wiki/Console_Command_List/B","availability":"Source dedicated-server console","risk":"GAME_CONSOLE_COMMAND_RISK_DESTRUCTIVE"},
      {"command":"removeid","syntax":"removeid <steamid>","summary":"Remove a ban-list entry.","description":"Removes a Steam ID from the server ban list.","category":"Moderation","aliases":[],"keywords":["ban","unban","steamid"],"arguments":[{"name":"steamid","description":"Steam ID to remove from the ban list.","required":true,"repeatable":false,"valueType":"steamid","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"removeid 76561198123456789","description":"Remove a ban-list entry."}],"notes":["Persist changes with writeid when appropriate."],"documentationUrl":"https://developer.valvesoftware.com/wiki/Console_Command_List/R","availability":"Source dedicated-server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
      {"command":"writeid","syntax":"writeid","summary":"Write the ban list to disk.","description":"Persists the current user ID ban list.","category":"Configuration","aliases":[],"keywords":["ban","save","config"],"arguments":[],"examples":[{"command":"writeid","description":"Persist ban-list changes."}],"notes":[],"documentationUrl":"https://developer.valvesoftware.com/wiki/Console_Command_List/W","availability":"Source dedicated-server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
