    "consoleCommands": [
      {"command":"find","syntax":"find <text>","summary":"Search registered commands and variables.","description":"Prints commands, variables, and descriptions matching the supplied text.","category":"Information","aliases":[],"keywords":["search","help","convar"],"arguments":[{"name":"text","description":"Text to search for.","required":true,"repeatable":true,"valueType":"text","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"find image","description":"Find image-related commands and variables."}],"notes":["Facepunch recommends using find in the server console to discover available commands."],"documentationUrl":"https://wiki.facepunch.com/rust/Creating-a-server","availability":"Rust dedicated-server console or RCON","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"users","syntax":"users","summary":"List users known to the server.","description":"Prints player Steam IDs and names.","category":"Players","aliases":[],"keywords":["players","steamid","list"],"arguments":[],"examples":[{"command":"users","description":"Find a player's Steam ID before granting permissions."}],"notes":[],"documentationUrl":"https://wiki.facepunch.com/rust/Creating-a-server","availability":"Rust dedicated-server console or RCON","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"status","syntax":"status","summary":"Show connected-player details.","description":"Returns connected players with Steam64ID, name, ping, time played, and IP address.","category":"Players","aliases":[],"keywords":["players","status","connections"],"arguments":[],"examples":[{"command":"status","description":"Inspect current connections."}],"notes":["Output contains player IP addresses."],"documentationUrl":"https://wiki.facepunch.com/rust/useful_commands","availability":"Rust dedicated-server console or RCON","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"say","syntax":"say <message>","summary":"Broadcast a server message.","description":"Broadcasts a message to chat from the server.","category":"Messaging","aliases":["sv say"],"keywords":["chat","broadcast","announce"],"arguments":[{"name":"message","description":"Message to broadcast.","required":true,"repeatable":true,"valueType":"text","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"say Server restart in 5 minutes.","description":"Announce planned maintenance."}],"notes":["In the server console use say. The sv say form is for an admin client console."],"documentationUrl":"https://wiki.facepunch.com/rust/useful_commands","availability":"Rust dedicated-server console or RCON","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"ownerid","syntax":"ownerid <steam64id> <name>","summary":"Grant owner authorization.","description":"Adds a player as a server owner (auth level 2).","category":"Access","aliases":[],"keywords":["admin","owner","permission","steamid"],"arguments":[{"name":"steam64id","description":"Player Steam64 ID.","required":true,"repeatable":false,"valueType":"steam64id","suggestedValues":[],"defaultValue":""},{"name":"name","description":"Player name.","required":true,"repeatable":true,"valueType":"player-name","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"ownerid 76561198123456789 ExamplePlayer","description":"Grant owner authorization."}],"notes":["The player must reconnect to receive the new auth level."],"documentationUrl":"https://wiki.facepunch.com/rust/Creating-a-server","availability":"Rust dedicated-server console or RCON","risk":"GAME_CONSOLE_COMMAND_RISK_DESTRUCTIVE"},
      {"command":"moderatorid","syntax":"moderatorid <steam64id> <name>","summary":"Grant moderator authorization.","description":"Adds a player as a server moderator (auth level 1).","category":"Access","aliases":[],"keywords":["moderator","permission","steamid"],"arguments":[{"name":"steam64id","description":"Player Steam64 ID.","required":true,"repeatable":false,"valueType":"steam64id","suggestedValues":[],"defaultValue":""},{"name":"name","description":"Player name.","required":true,"repeatable":true,"valueType":"player-name","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"moderatorid 76561198123456789 ExamplePlayer","description":"Grant moderator authorization."}],"notes":["The player must reconnect to receive the new auth level."],"documentationUrl":"https://wiki.facepunch.com/rust/Creating-a-server","availability":"Rust dedicated-server console or RCON","risk":"GAME_CONSOLE_COMMAND_RISK_DESTRUCTIVE"},
