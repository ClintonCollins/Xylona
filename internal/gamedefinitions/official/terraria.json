    "consoleCommands": [
      {"command":"help","syntax":"help","summary":"List dedicated-server console commands.","description":"Displays the server's available console commands.","category":"Information","aliases":[],"keywords":["commands","documentation"],"arguments":[],"examples":[{"command":"help","description":"Show the available commands."}],"notes":["Do not prefix with a forward slash in the server console."],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"playing","syntax":"playing","summary":"List connected players.","description":"Shows the players currently on the server.","category":"Players","aliases":[],"keywords":["players","list","online"],"arguments":[],"examples":[{"command":"playing","description":"Print the connected-player list."}],"notes":["In game chat, this command can be used as /playing."],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"say","syntax":"say <message>","summary":"Broadcast a server message.","description":"Sends a yellow <server>-prefixed message to all players.","category":"Messaging","aliases":[],"keywords":["broadcast","chat","announce"],"arguments":[{"name":"message","description":"Message sent to every connected player.","required":true,"repeatable":true,"valueType":"text","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"say Server restart in 5 minutes.","description":"Announce planned maintenance."}],"notes":["Do not prefix with a forward slash in the server console."],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"save","syntax":"save","summary":"Save the current world.","description":"Writes the running world to disk.","category":"World","aliases":[],"keywords":["world","backup","persist"],"arguments":[],"examples":[{"command":"save","description":"Save before maintenance."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
      {"command":"exit","syntax":"exit","summary":"Save and stop the server.","description":"Shuts down the dedicated server after saving the world.","category":"Lifecycle","aliases":[],"keywords":["shutdown","stop","save"],"arguments":[],"examples":[{"command":"exit","description":"Perform a clean shutdown."}],"notes":["Xylona's lifecycle controls are usually preferable for stopping a managed server."],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_DESTRUCTIVE"},
      {"command":"exit-nosave","syntax":"exit-nosave","summary":"Stop the server without saving.","description":"Shuts down the dedicated server without saving world changes.","category":"Lifecycle","aliases":[],"keywords":["shutdown","stop","discard"],"arguments":[],"examples":[{"command":"exit-nosave","description":"Stop without persisting current changes."}],"notes":["Can discard recent world changes."],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_DESTRUCTIVE"},
      {"command":"kick","syntax":"kick <player name>","summary":"Disconnect a player.","description":"Kicks the named player from the server.","category":"Moderation","aliases":[],"keywords":["player","disconnect","moderation"],"arguments":[{"name":"player name","description":"Name of the player to disconnect.","required":true,"repeatable":false,"valueType":"player-name","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"kick ExamplePlayer","description":"Disconnect ExamplePlayer."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
      {"command":"ban","syntax":"ban <player name>","summary":"Ban a player.","description":"Bans the named player from the server.","category":"Moderation","aliases":[],"keywords":["player","ban","moderation"],"arguments":[{"name":"player name","description":"Name of the player to ban.","required":true,"repeatable":false,"valueType":"player-name","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"ban ExamplePlayer","description":"Ban ExamplePlayer."}],"notes":["To unban a player, edit banlist.txt as documented by Terraria."],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_DESTRUCTIVE"},
      {"command":"password","syntax":"password [password]","summary":"Show or change the server password.","description":"Without an argument, displays the password; with one, changes it.","category":"Access","aliases":[],"keywords":["password","access","security"],"arguments":[{"name":"password","description":"New server password.","required":false,"repeatable":false,"valueType":"secret","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"password NewPassword","description":"Change the server password."}],"notes":["Entering password without an argument exposes the current password in console output."],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
      {"command":"motd","syntax":"motd [message]","summary":"Show or change the message of the day.","description":"Without an argument, prints the MOTD; with one, changes it.","category":"Messaging","aliases":[],"keywords":["motd","message","welcome"],"arguments":[{"name":"message","description":"New message of the day.","required":false,"repeatable":true,"valueType":"text","suggestedValues":[],"defaultValue":""}],"examples":[{"command":"motd Welcome to our server!","description":"Set a new MOTD."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"version","syntax":"version","summary":"Print server version information.","description":"Prints the Terraria version number.","category":"Information","aliases":[],"keywords":["version","build"],"arguments":[],"examples":[{"command":"version","description":"Display the server version."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"time","syntax":"time","summary":"Display in-game time.","description":"Prints the current game time.","category":"World","aliases":[],"keywords":["time","world"],"arguments":[],"examples":[{"command":"time","description":"Display the current game time."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"port","syntax":"port","summary":"Print the listening port.","description":"Shows the port used by the dedicated server.","category":"Information","aliases":[],"keywords":["port","network"],"arguments":[],"examples":[{"command":"port","description":"Display the listening port."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"maxplayers","syntax":"maxplayers","summary":"Print the maximum player count.","description":"Shows the configured maximum number of players.","category":"Information","aliases":[],"keywords":["players","capacity"],"arguments":[],"examples":[{"command":"maxplayers","description":"Display configured player capacity."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_NONE"},
      {"command":"dawn","syntax":"dawn","summary":"Set world time to dawn.","description":"Changes the game time to 4:30 AM.","category":"World","aliases":[],"keywords":["time","morning","world"],"arguments":[],"examples":[{"command":"dawn","description":"Set time to dawn."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
      {"command":"noon","syntax":"noon","summary":"Set world time to noon.","description":"Changes the game time to 12:00 PM.","category":"World","aliases":[],"keywords":["time","day","world"],"arguments":[],"examples":[{"command":"noon","description":"Set time to noon."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
      {"command":"dusk","syntax":"dusk","summary":"Set world time to dusk.","description":"Changes the game time to 7:30 PM.","category":"World","aliases":[],"keywords":["time","evening","world"],"arguments":[],"examples":[{"command":"dusk","description":"Set time to dusk."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
      {"command":"midnight","syntax":"midnight","summary":"Set world time to midnight.","description":"Changes the game time to 12:00 AM.","category":"World","aliases":[],"keywords":["time","night","world"],"arguments":[],"examples":[{"command":"midnight","description":"Set time to midnight."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"},
      {"command":"settle","syntax":"settle","summary":"Settle all water.","description":"Settles all flowing water in the world.","category":"World","aliases":[],"keywords":["water","world"],"arguments":[],"examples":[{"command":"settle","description":"Settle water after a world change."}],"notes":[],"documentationUrl":"https://terraria.wiki.gg/wiki/Dedicated_Server","availability":"Dedicated server console","risk":"GAME_CONSOLE_COMMAND_RISK_CAUTION"}
    ]
