  "config_schemas": [
    {
      "path": "serverconfig.txt",
      "format": "commandcfg",
      "category": "Server",
      "generate_before_start": true,
      "managed_fields": {
        "maxplayers": "game_server.max_players",
        "port": "game_server.port",
        "worldname": "game_server.server_name"
      },
      "schema": {
        "type": "object",
        "x-groups": [
          "Identity",
          "Access",
          "World",
          "Networking"
        ],
        "properties": {
          "motd": {
            "type": "string",
            "title": "MOTD",
            "default": "Welcome to Terraria",
            "x-group": "Identity",
            "x-order": 0
          },
          "password": {
            "type": "string",
            "title": "Password",
            "default": "",
            "x-group": "Access",
            "x-order": 0
          },
          "maxplayers": {
            "type": "integer",
            "title": "Max players",
            "default": 16,
            "minimum": 1,
            "maximum": 255,
            "x-group": "Access",
            "x-order": 1,
            "x-managed": {
              "source": "game_server.max_players"
            }
          },
          "world": {
            "type": "string",
            "title": "World file",
            "default": "worlds/default.wld",
            "x-group": "World",
            "x-order": 0
          },
          "worldname": {
            "type": "string",
            "title": "World name",
            "default": "Xylona Terraria Server",
            "x-group": "World",
            "x-order": 1,
            "x-managed": {
              "source": "game_server.server_name"
            }
          },
          "autocreate": {
            "type": "integer",
            "title": "Create world size",
            "description": "Creates the configured world when it does not exist: 1 small, 2 medium, 3 large.",
            "default": 2,
            "minimum": 1,
            "maximum": 3,
            "x-group": "World",
            "x-order": 2
          },
          "difficulty": {
            "type": "integer",
            "title": "World difficulty",
            "description": "0 classic, 1 expert, 2 master, 3 journey.",
            "default": 0,
            "minimum": 0,
            "maximum": 3,
            "x-group": "World",
            "x-order": 3
          },
          "worldrollbackstokeep": {
            "type": "integer",
            "title": "World rollback copies",
            "default": 2,
            "minimum": 0,
            "maximum": 100,
            "x-group": "World",
            "x-order": 4
          },
          "port": {
            "type": "integer",
            "title": "Server port",
            "default": 7777,
            "minimum": 1,
            "maximum": 65535,
            "x-group": "Networking",
            "x-order": 0,
            "x-managed": {
              "source": "game_server.port"
            }
          },
          "secure": {
            "type": "integer",
            "title": "Cheat protection",
            "default": 1,
            "minimum": 0,
            "maximum": 1,
            "x-group": "Networking",
            "x-order": 1
          },
          "upnp": {
            "type": "integer",
            "title": "Automatic UPnP forwarding",
            "description": "Disabled by default so multiple managed servers do not compete for router mappings.",
            "default": 0,
            "minimum": 0,
            "maximum": 1,
            "x-group": "Networking",
            "x-order": 2
          }
        }
      }
    }
  ],
