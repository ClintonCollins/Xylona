            "x-group": "Dynamic Mesh",
            "x-order": 2
          },
          "DynamicMeshMaxItemCache": {
            "type": "integer",
            "title": "Dynamic mesh item cache",
            "default": 3,
            "minimum": 1,
            "description": "Items processed concurrently by dynamic mesh. Higher values use more memory.",
            "x-group": "Dynamic Mesh",
            "x-order": 3
          },
          "TwitchServerPermission": {
            "type": "integer",
            "title": "Twitch permission level",
            "default": 90,
            "minimum": 0,
            "maximum": 1000,
            "description": "Maximum permission level allowed to use Twitch integration. Lower values grant more access.",
